{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archipela-Go 2 slot_data v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goals",
    "goal_requirement",
    "goal_need",
    "minutes_per_tier",
    "reduction_percent",
    "min_distance_m",
    "fog_of_war",
    "return_home",
    "death_link",
    "enabled_traps",
    "zones",
    "trips",
    "boss"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "treasure_hunt",
          "all_trips"
        ]
      }
    },
    "goal_requirement": {
      "enum": [
        "any",
        "all",
        "at_least"
      ]
    },
    "goal_need": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "minutes_per_tier": {
      "type": "integer",
      "minimum": 5,
      "maximum": 30
    },
    "reduction_percent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "min_distance_m": {
      "type": "integer",
      "minimum": 50,
      "maximum": 5000
    },
    "fog_of_war": {
      "type": "boolean"
    },
    "return_home": {
      "type": "boolean"
    },
    "death_link": {
      "type": "boolean"
    },
    "enabled_traps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "freeze",
          "fog",
          "shuffle",
          "silence",
          "leash",
          "detour",
          "toll",
          "slow",
          "honor"
        ]
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "zone_keys_needed",
          "tool"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "mode": {
            "$ref": "#/$defs/mode"
          },
          "zone_keys_needed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "tool": {
            "enum": [
              "Running Shoes",
              null
            ]
          }
        }
      }
    },
    "trips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "boss": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/quest"
        }
      ]
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "walk",
        "run"
      ]
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "zone",
        "mode",
        "difficulty",
        "effort_tier",
        "type"
      ],
      "properties": {
        "location_id": {
          "type": "integer",
          "minimum": 1
        },
        "zone": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "effort_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
